{
  "name": "wall-of-dead",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "description": "Behind-the-wall 2.5D-in-3D zombie survival defense. Three.js + Vite, zero art/audio assets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron": "electron .",
    "standalone": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:win:installer": "npm run build && electron-builder --win nsis",
    "verify": "tsc --noEmit && vite build",
    "smoke": "electron scripts/smoke-electron.cjs",
    "test:play": "npm run build && electron scripts/smoke-electron.cjs",
    "test:perf": "npm run build && electron scripts/perf-electron.cjs",
    "qa:cycle": "node qa/loop.mjs",
    "qa:capture": "npm run build && electron qa/capture.cjs",
    "qa:check": "node qa/check.mjs",
    "qa:maps": "npm run build && electron qa/capture-maps.cjs",
    "qa:scenarios": "npm run build && electron qa/capture-scenarios.cjs",
    "qa:perf-supply": "npm run build && electron qa/perf-supply.cjs",
    "qa:diagnose": "npm run build && electron qa/diagnose.cjs",
    "qa:baseline": "npm run build && electron qa/diagnose.cjs --baseline"
  },
  "author": "Justin Kramer",
  "build": {
    "appId": "com.wallofdead.game",
    "productName": "Wall of Dead",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "electron-main.cjs",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Wall-of-Dead-${version}.exe"
    }
  },
  "dependencies": {
    "@fontsource/oswald": "^5.2.5",
    "@fontsource/rajdhani": "^5.2.7",
    "postprocessing": "^6.36.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
