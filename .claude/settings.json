{
  "permissions": {
    "allow": [
      "Bash(node check-imports.mjs)",
      "Bash(python -m http.server:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/check-imports.mjs\""
          }
        ]
      }
    ]
  }
}
